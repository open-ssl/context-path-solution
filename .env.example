# Copy to .env and adjust for your environment.

# Data sources mounted read-only into containers.
DATA_DIR=./data
RULES_FILE=./rules.json

# Streamer pacing: real milliseconds per one-second-of-recording tick.
TICK_MS=25

# Infrastructure ports & hosts
NATS_HOST=nats
NATS_PORT=4222

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_USER=contextpath
POSTGRES_PASSWORD=contextpath
POSTGRES_DB=contextpath

# Read API gateway port
SERVER_PORT=8080